      "required": [
        "id",
        "source",
        "target",
        "references",
        "locations",
        "relation",
        "role",
        "trust"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/index"
        },
        "source": {
          "$ref": "#/$defs/index"
        },
        "target": {
          "$ref": "#/$defs/index"
        },
        "references": {
          "type": "integer",
          "minimum": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "relation": {
          "enum": [
            "uses",
            "module_ownership"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "test",
