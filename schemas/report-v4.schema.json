        "after": {
          "oneOf": [
            {
              "$ref": "#/$defs/measurements"
            },
            {
              "type": "null"
            }
          ]
        },
        "ratings": {
          "$ref": "#/$defs/ratings"
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": [
        "id",
        "healthy",
        "watch",
        "high"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/index"
        },
        "healthy": {
          "type": "integer",
          "minimum": 0
        },
        "watch": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
