        "resolved_internal_uses": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_internal_uses": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_internal_uses": {
          "type": "integer",
          "minimum": 0
        },
        "external_uses": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_package_uses": {
          "type": "integer",
          "minimum": 0
        },
        "module_ownership_relations": {
          "type": "integer",
          "minimum": 0
        },
        "context_relations": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
