        "path": {
          "$ref": "#/$defs/nullable_index"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "architecture_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "architecture_comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "evolutionary_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "evolutionary_comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "uniqueItems": true
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "health": {
          "$ref": "#/$defs/index"
        },
        "diff": {
          "$ref": "#/$defs/diff"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "path",
        "language",
        "coverage",
        "health",
        "activity",
        "package",
        "role",
        "parse_outcome",
        "trust"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/index"
        },
        "scope": {
          "$ref": "#/$defs/index"
        },
        "path": {
          "$ref": "#/$defs/nullable_index"
        },
        "language": {
          "type": [
            "string",
