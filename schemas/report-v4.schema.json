        },
        "touches": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "dependency_coverage": {
      "type": "object",
      "required": [
        "internal",
        "external",
        "unresolved",
        "ambiguous",
        "resolved_internal_uses",
        "unresolved_internal_uses",
        "ambiguous_internal_uses",
        "external_uses",
        "unresolved_package_uses",
        "module_ownership_relations",
        "context_relations",
        "total"
      ],
      "properties": {
        "internal": {
          "type": "integer",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
