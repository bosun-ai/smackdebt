      "type": "object",
      "required": [
        "worse",
        "better",
        "changed",
        "total"
      ],
      "properties": {
        "worse": {
          "type": "integer",
          "minimum": 0
        },
        "better": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
