    "stable_dependency_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stable_dependency_finding"
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotspot"
      }
