        "healthy",
        "watch",
        "high"
      ]
    },
    "nullable_rating": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "healthy",
        "watch",
        "high",
        null
      ]
    },
    "unit_kind": {
      "enum": [
        "function",
        "method",
        "closure",
        "lambda",
        "synthetic_top_level",
        "template"
      ]
