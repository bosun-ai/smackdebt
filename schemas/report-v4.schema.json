        "selected_files": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed_files": {
          "type": "integer",
          "minimum": 0
        },
        "clean_files": {
          "type": "integer",
          "minimum": 0
        },
        "recovered_files": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_files": {
          "type": "integer",
          "minimum": 0
        },
        "failed_files": {
          "type": "integer",
          "minimum": 0
        },
        "context_files": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_lines": {
          "type": "integer",
          "minimum": 0
        },
        "selected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
