      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/nullable_rating"
        },
        "after": {
          "$ref": "#/$defs/nullable_rating"
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "id",
        "file",
        "start_line",
        "end_line",
        "name",
        "container",
        "unit_kind",
        "kind",
        "direction",
        "before",
        "after",
        "ratings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/index"
        },
        "file": {
          "$ref": "#/$defs/nullable_index"
        },
        "name": {
          "type": "string"
        },
        "container": {
