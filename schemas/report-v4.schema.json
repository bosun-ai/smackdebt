      }
    },
    "package_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package_history"
      }
    },
    "change_coupling": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change_coupling"
      }
    },
    "contributor_concentration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contributor_concentration"
      }
    },
    "evolutionary_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evolutionary_finding"
      }
