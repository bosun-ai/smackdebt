{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smackdebt.dev/schema/report-v2.json",
  "title": "Smackdebt report version 2",
  "type": "object",
  "required": ["schema_version", "mode", "root", "selected_scope", "paths", "scopes", "files", "findings", "diagnostics", "comparisons", "health", "activity", "dependency_coverage", "dependency_edges", "package_edges", "external_dependencies", "resolution_diagnostics", "package_graph", "architecture_findings", "architecture_comparisons", "history_coverage", "file_history", "package_history", "change_coupling", "contributor_concentration", "evolutionary_findings", "evolutionary_comparisons"],
  "properties": {
    "schema_version": { "const": 2 },
    "mode": { "enum": ["codebase", "diff"] },
    "root": { "$ref": "#/$defs/nullable_index" },
    "selected_scope": { "$ref": "#/$defs/nullable_index" },
    "paths": { "type": "array", "items": { "type": "string" } },
    "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
    "health": { "type": "array", "items": { "$ref": "#/$defs/health" } },
    "activity": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
    "dependency_coverage": { "$ref": "#/$defs/dependency_coverage" },
    "dependency_edges": { "type": "array", "items": { "$ref": "#/$defs/dependency_edge" } },
    "package_edges": { "type": "array", "items": { "$ref": "#/$defs/package_edge" } },
    "external_dependencies": { "type": "array", "items": { "$ref": "#/$defs/external_dependency" } },
    "resolution_diagnostics": { "type": "array", "items": { "$ref": "#/$defs/resolution_diagnostic" } },
    "package_graph": { "type": "array", "items": { "$ref": "#/$defs/package_graph" } },
    "architecture_findings": { "type": "array", "items": { "$ref": "#/$defs/architecture_finding" } },
    "architecture_comparisons": { "type": "array", "items": { "$ref": "#/$defs/architecture_comparison" } },
    "history_coverage": { "$ref": "#/$defs/history_coverage" },
    "file_history": { "type": "array", "items": { "$ref": "#/$defs/file_history" } },
    "package_history": { "type": "array", "items": { "$ref": "#/$defs/package_history" } },
    "change_coupling": { "type": "array", "items": { "$ref": "#/$defs/change_coupling" } },
    "contributor_concentration": { "type": "array", "items": { "$ref": "#/$defs/contributor_concentration" } },
    "evolutionary_findings": { "type": "array", "items": { "$ref": "#/$defs/evolutionary_finding" } },
    "evolutionary_comparisons": { "type": "array", "items": { "$ref": "#/$defs/evolutionary_comparison" } }
  },
  "additionalProperties": false,
  "$defs": {
    "index": { "type": "integer", "minimum": 0 },
    "nullable_index": { "type": ["integer", "null"], "minimum": 0 },
    "rating": { "enum": ["healthy", "watch", "high"] },
    "nullable_rating": { "type": ["string", "null"], "enum": ["healthy", "watch", "high", null] },
    "unit_kind": { "enum": ["function", "method", "closure", "lambda", "synthetic_top_level", "template"] },
    "coverage": {
      "type": "object",
      "required": ["selected_files", "analyzed_files", "clean_files", "recovered_files", "unsupported_files", "failed_files", "context_files", "source_lines", "excluded_lines"],
      "properties": {
        "selected_files": { "type": "integer", "minimum": 0 },
        "analyzed_files": { "type": "integer", "minimum": 0 },
        "clean_files": { "type": "integer", "minimum": 0 },
        "recovered_files": { "type": "integer", "minimum": 0 },
        "unsupported_files": { "type": "integer", "minimum": 0 },
        "failed_files": { "type": "integer", "minimum": 0 },
        "context_files": { "type": "integer", "minimum": 0 },
        "source_lines": { "type": "integer", "minimum": 0 },
        "excluded_lines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["worse", "better", "changed", "total"],
      "properties": {
        "worse": { "type": "integer", "minimum": 0 },
        "better": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "required": ["cognitive_complexity", "cyclomatic_complexity", "logical_lines"],
      "properties": {
        "cognitive_complexity": { "type": "integer", "minimum": 0 },
        "cyclomatic_complexity": { "type": "integer", "minimum": 0 },
        "logical_lines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["id", "kind", "parent", "children", "path", "findings", "comparisons", "architecture_findings", "architecture_comparisons", "evolutionary_findings", "evolutionary_comparisons", "coverage", "health", "diff"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "kind": { "enum": ["repository", "package", "directory", "file"] },
        "parent": { "$ref": "#/$defs/nullable_index" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "path": { "$ref": "#/$defs/nullable_index" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "comparisons": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "architecture_findings": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "architecture_comparisons": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "evolutionary_findings": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "evolutionary_comparisons": { "type": "array", "items": { "$ref": "#/$defs/index" }, "uniqueItems": true },
        "coverage": { "$ref": "#/$defs/coverage" },
        "health": { "$ref": "#/$defs/index" },
        "diff": { "$ref": "#/$defs/diff" }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["id", "scope", "path", "language", "coverage", "health", "activity", "package", "role", "trust"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "scope": { "$ref": "#/$defs/index" },
        "path": { "$ref": "#/$defs/nullable_index" },
        "language": { "type": ["string", "null"], "enum": ["c", "cpp", "java", "javascript", "jsx", "python", "rust", "typescript", "tsx", "ruby", "vue", "kotlin", "unknown", null] },
        "coverage": { "$ref": "#/$defs/coverage" },
        "health": { "$ref": "#/$defs/index" },
        "activity": { "$ref": "#/$defs/index" }
        ,"package": { "$ref": "#/$defs/nullable_index" },
        "role": { "enum": ["primary", "test", "example", "benchmark", "fixture", "generated"] },
        "trust": { "enum": ["trusted", "advisory", "failed"] }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "file", "name", "container", "kind", "start_line", "end_line", "rating", "measurements", "role", "trust"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "file": { "$ref": "#/$defs/index" },
        "name": { "type": "string" },
        "container": { "type": ["string", "null"] },
        "kind": { "$ref": "#/$defs/unit_kind" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "rating": { "$ref": "#/$defs/rating" },
        "measurements": { "$ref": "#/$defs/measurements" },
        "role": { "enum": ["primary", "test", "example", "benchmark", "fixture", "generated"] },
        "trust": { "enum": ["trusted", "advisory", "failed"] }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["id", "file", "kind", "message", "excluded_lines"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "file": { "$ref": "#/$defs/nullable_index" },
        "kind": { "enum": ["unsupported_language", "unreadable_file", "oversized_file", "parse_failure", "ambiguous_identity", "unsafe_reference", "other"] },
        "message": { "type": "string" },
        "excluded_lines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ratings": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/nullable_rating" },
        "after": { "$ref": "#/$defs/nullable_rating" }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["id", "file", "name", "container", "unit_kind", "kind", "direction", "before", "after", "ratings"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "file": { "$ref": "#/$defs/nullable_index" },
        "name": { "type": "string" },
        "container": { "type": ["string", "null"] },
        "unit_kind": { "$ref": "#/$defs/unit_kind" },
        "kind": { "enum": ["added", "removed", "improved", "regressed", "metric_changed", "ambiguous", "unchanged"] },
        "direction": { "enum": ["worse", "better", "changed"] },
        "before": { "oneOf": [{ "$ref": "#/$defs/measurements" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/measurements" }, { "type": "null" }] },
        "ratings": { "$ref": "#/$defs/ratings" }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["id", "healthy", "watch", "high"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "healthy": { "type": "integer", "minimum": 0 },
        "watch": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "file", "touches"],
      "properties": {
        "id": { "$ref": "#/$defs/index" },
        "file": { "$ref": "#/$defs/index" },
        "touches": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dependency_coverage": {
      "type": "object", "required": ["internal","external","unresolved","ambiguous","total"],
      "properties": { "internal":{"type":"integer","minimum":0}, "external":{"type":"integer","minimum":0}, "unresolved":{"type":"integer","minimum":0}, "ambiguous":{"type":"integer","minimum":0}, "total":{"type":"integer","minimum":0} }, "additionalProperties": false
    },
    "dependency_edge": {
      "type":"object", "required":["id","source","target","references","locations","role","trust"],
      "properties":{"id":{"$ref":"#/$defs/index"},"source":{"$ref":"#/$defs/index"},"target":{"$ref":"#/$defs/index"},"references":{"type":"integer","minimum":1},"locations":{"type":"array","items":{"type":"array","items":{"type":"integer","minimum":1},"minItems":2,"maxItems":2}},"role":{"enum":["primary","test","example","benchmark","fixture","generated"]},"trust":{"enum":["trusted","advisory","failed"]}}, "additionalProperties":false
    },
    "package_edge": {
      "type":"object", "required":["id","source","target","file_pairs","references","file_edges"],
      "properties":{"id":{"$ref":"#/$defs/index"},"source":{"$ref":"#/$defs/index"},"target":{"$ref":"#/$defs/index"},"file_pairs":{"type":"integer","minimum":1},"references":{"type":"integer","minimum":1},"file_edges":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true}}, "additionalProperties":false
    },
    "package_graph": {
      "type":"object", "required":["package","fan_in","fan_out","instability"],
      "properties":{"package":{"$ref":"#/$defs/index"},"fan_in":{"type":"integer","minimum":0},"fan_out":{"type":"integer","minimum":0},"instability":{"oneOf":[{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},{"type":"null"}]}}, "additionalProperties":false
    },
    "external_dependency": {
      "type":"object", "required":["file","target","references"],
      "properties":{"file":{"$ref":"#/$defs/index"},"target":{"type":"string"},"references":{"type":"integer","minimum":1}}, "additionalProperties":false
    },
    "resolution_diagnostic": {
      "type":"object", "required":["file","start_line","end_line","target","kind","reason"],
      "properties":{"file":{"$ref":"#/$defs/index"},"start_line":{"type":"integer","minimum":1},"end_line":{"type":"integer","minimum":1},"target":{"type":"string"},"kind":{"enum":["unresolved","ambiguous"]},"reason":{"type":"string"}}, "additionalProperties":false
    },
    "architecture_finding": {
      "type":"object", "required":["id","kind","rating","packages","files","witness_edges"],
      "properties":{"id":{"$ref":"#/$defs/index"},"kind":{"enum":["package_cycle","file_cycle"]},"rating":{"enum":["watch","high"]},"packages":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true},"files":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true},"witness_edges":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true}}, "additionalProperties":false
    },
    "architecture_comparison": {
      "type":"object", "required":["id","kind","direction","packages","witness","files"],
      "properties":{"id":{"$ref":"#/$defs/index"},"kind":{"enum":["edge_added","edge_removed","cycle_introduced","cycle_removed"]},"direction":{"enum":["worse","better","changed"]},"packages":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true},"witness":{"type":"array","items":{"$ref":"#/$defs/index"}},"files":{"type":"array","items":{"$ref":"#/$defs/index"},"uniqueItems":true}}, "additionalProperties":false
    },
    "history_coverage": {
      "type":"object", "required":["availability","revision","commits","newest_timestamp","oldest_timestamp","textual_changes","uncounted_changes","excluded_paths","rename_gaps","reason"],
      "properties":{"availability":{"enum":["complete","incomplete","unavailable"]},"revision":{"type":["string","null"]},"commits":{"type":"integer","minimum":0},"newest_timestamp":{"type":["integer","null"]},"oldest_timestamp":{"type":["integer","null"]},"textual_changes":{"type":"integer","minimum":0},"uncounted_changes":{"type":"integer","minimum":0},"excluded_paths":{"type":"integer","minimum":0},"rename_gaps":{"type":"integer","minimum":0},"reason":{"type":["string","null"]}}, "additionalProperties":false
    },
    "file_history": {
      "type":"object", "required":["file","touches","added_lines","deleted_lines","uncounted_changes"],
      "properties":{"file":{"$ref":"#/$defs/index"},"touches":{"type":"integer","minimum":0},"added_lines":{"type":"integer","minimum":0},"deleted_lines":{"type":"integer","minimum":0},"uncounted_changes":{"type":"integer","minimum":0}}, "additionalProperties":false
    },
    "package_history": {
      "type":"object", "required":["package","touches","added_lines","deleted_lines","uncounted_changes"],
      "properties":{"package":{"$ref":"#/$defs/index"},"touches":{"type":"integer","minimum":0},"added_lines":{"type":"integer","minimum":0},"deleted_lines":{"type":"integer","minimum":0},"uncounted_changes":{"type":"integer","minimum":0}}, "additionalProperties":false
    },
    "change_coupling": {
      "type":"object", "required":["left","right","shared_commits","union_commits","similarity"],
      "properties":{"left":{"$ref":"#/$defs/index"},"right":{"$ref":"#/$defs/index"},"shared_commits":{"type":"integer","minimum":2},"union_commits":{"type":"integer","minimum":2},"similarity":{"type":"number","minimum":0,"maximum":1}}, "additionalProperties":false
    },
    "contributor_concentration": {
      "type":"object", "required":["package","contributor_count","numerator","denominator","ratio"],
      "properties":{"package":{"$ref":"#/$defs/index"},"contributor_count":{"type":"integer","minimum":1},"numerator":{"type":"integer","minimum":1},"denominator":{"type":"integer","minimum":1},"ratio":{"type":"number","minimum":0,"maximum":1}}, "additionalProperties":false
    },
    "evolutionary_finding": {
      "type":"object", "required":["id","rating","left","right","shared_commits","union_commits","similarity"],
      "properties":{"id":{"$ref":"#/$defs/index"},"rating":{"const":"watch"},"left":{"$ref":"#/$defs/index"},"right":{"$ref":"#/$defs/index"},"shared_commits":{"type":"integer","minimum":2},"union_commits":{"type":"integer","minimum":2},"similarity":{"type":"number","minimum":0,"maximum":1}}, "additionalProperties":false
    },
    "evolutionary_comparison": {
      "type":"object", "required":["id","kind","direction","left","right","shared_commits","union_commits","similarity"],
      "properties":{"id":{"$ref":"#/$defs/index"},"kind":{"enum":["finding_introduced","finding_removed"]},"direction":{"enum":["worse","better"]},"left":{"$ref":"#/$defs/index"},"right":{"$ref":"#/$defs/index"},"shared_commits":{"type":"integer","minimum":2},"union_commits":{"type":"integer","minimum":2},"similarity":{"type":"number","minimum":0,"maximum":1}}, "additionalProperties":false
    }
  }
}
