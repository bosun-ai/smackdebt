#!/bin/sh
# Release template: the build supplies the CLI version.
set -eu

main() {
    for option in "$@"; do
        case "$option" in
            --help|-h)
                printf '%s\n' 'Usage: install.sh' 'Installs the Smackdebt binary. Run smackdebt init to set up agent skills.'
                return ;;
            *)
                printf 'smackdebt: unsupported option: %s. Use smackdebt init for agent skills.\n' "$option" >&2
                return 2 ;;
        esac
    done
    command -v curl >/dev/null 2>&1 || { printf 'smackdebt: curl is required\n' >&2; return 1; }
    temporary=$(mktemp -d "${TMPDIR:-/tmp}/smackdebt-install.XXXXXX")
    trap 'rm -rf "$temporary"' 0
    trap 'exit 130' INT
    trap 'exit 143' TERM
    curl --proto '=https' --tlsv1.2 -fsSL \
        'https://github.com/bosun-ai/smackdebt/releases/download/v@VERSION@/smackdebt-installer.sh' \
        -o "$temporary/install.sh"
    sh "$temporary/install.sh" </dev/null
    printf '\nRun smackdebt init to install or update skills for your agents.\n'
}

# Read the complete script before executing when piped into sh.
main "$@"
